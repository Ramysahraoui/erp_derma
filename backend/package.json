{
  "name": "@erp-derma/backend",
  "version": "1.0.0",
  "private": true,
  "description": "ERP/MES dermo-cosmetique - API backend",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "migrate": "tsx src/db/cli-migrate.ts",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "amorcer": "tsx src/db/cli-amorcer.ts",
    "demonstration": "tsx src/db/cli-demo.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/multipart": "^9.0.1",
    "@fastify/static": "^10.1.4",
    "bcryptjs": "^2.4.3",
    "decimal.js": "^10.4.3",
    "fastify": "^5.2.0",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
