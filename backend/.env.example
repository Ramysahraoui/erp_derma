# Connexion PostgreSQL
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/erp_derma
# Base utilisee par la suite de tests (reinitialisee a chaque execution)
DATABASE_URL_TEST=postgres://postgres:postgres@127.0.0.1:5432/erp_derma_test

# Serveur HTTP
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Securite : a remplacer imperativement en production
JWT_SECRET=changez-cette-cle-en-production
JWT_EXPIRES_IN=12h

# Stockage des certificats d'analyse et pieces jointes
UPLOAD_DIR=./uploads

# Moteur de rendu PDF (Chromium). Laisser vide pour detection automatique.
CHROMIUM_PATH=

# Identite de la societe imprimee sur les documents
SOCIETE_NOM=Laboratoire Dermo-Cosmetique
SOCIETE_ADRESSE=Zone industrielle - Unite de fabrication
SOCIETE_TEL=
SOCIETE_EMAIL=
SOCIETE_RC=
SOCIETE_NIF=
DEVISE=DZD
