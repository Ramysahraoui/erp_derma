# =====================================================================
# Configuration du deploiement — copier en « .env » et adapter.
# Le script ./installer.sh genere ce fichier automatiquement avec des
# secrets aleatoires s'il n'existe pas encore.
# =====================================================================

# --- Port d'acces a l'application depuis le reseau local -------------
PORT_WEB=8080

# --- Secrets (generes automatiquement par installer.sh) --------------
POSTGRES_PASSWORD=
JWT_SECRET=

# --- Base de donnees -------------------------------------------------
POSTGRES_DB=erp_derma
POSTGRES_USER=erp

# --- Compte administrateur initial -----------------------------------
# Cree uniquement au premier demarrage. Si le mot de passe est laisse
# vide, l'application en genere un et l'affiche dans les journaux
# d'installation (docker compose logs api). Changement impose a la
# premiere connexion dans tous les cas.
ADMIN_EMAIL=admin@local
ADMIN_NOM=Administrateur
ADMIN_MOT_DE_PASSE=

# --- Identite imprimee sur les documents (BL, factures, dossiers) ----
SOCIETE_NOM=Laboratoire Dermo-Cosmetique
SOCIETE_ADRESSE=Zone industrielle
SOCIETE_TEL=
SOCIETE_EMAIL=
SOCIETE_RC=
SOCIETE_NIF=
DEVISE=DZD

# --- Divers -----------------------------------------------------------
TZ=Africa/Algiers
JWT_EXPIRES_IN=12h
LOG_LEVEL=info
